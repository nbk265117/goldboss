{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dofus-companion.local/schemas/knowledge-package.v1.json",
  "title": "Dofus Companion knowledge package (format version 1)",
  "description": "Entities, mechanics and sources importable into Dofus Companion. Imported content is data only and is never executed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "packageId", "name", "createdOn", "sources", "entities", "mechanics"],
  "properties": {
    "$schema": { "type": "string" },
    "formatVersion": { "const": 1 },
    "packageId": { "$ref": "#/definitions/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": ["string", "null"], "maxLength": 4000 },
    "author": { "type": ["string", "null"], "maxLength": 200 },
    "createdOn": { "$ref": "#/definitions/date" },
    "testOnly": {
      "type": "boolean",
      "description": "True for synthetic fixtures. The application refuses to import test-only packages into a user database."
    },
    "gameVersions": { "type": "array", "maxItems": 200, "items": { "$ref": "#/definitions/gameVersion" } },
    "sources": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/definitions/source" } },
    "entities": { "type": "array", "maxItems": 100000, "items": { "$ref": "#/definitions/entity" } },
    "mechanics": { "type": "array", "maxItems": 20000, "items": { "$ref": "#/definitions/mechanic" } }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "nullableDate": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "nullableText": { "type": ["string", "null"], "maxLength": 4000 },
    "verification": { "enum": ["VERIFIED", "COMMUNITY_REPORTED", "INFERRED", "UNKNOWN"] },
    "entityType": {
      "enum": ["Monster", "Boss", "Dungeon", "Area", "Map", "Spell", "MonsterFamily", "CharacterClass", "Quest", "Achievement"]
    },
    "gameVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "version": { "type": ["string", "null"], "maxLength": 50 },
        "releaseDate": { "$ref": "#/definitions/nullableDate" },
        "sourceId": { "type": ["string", "null"] },
        "verifiedOn": { "$ref": "#/definitions/nullableDate" },
        "notes": { "$ref": "#/definitions/nullableText" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "reliability"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "url": { "type": ["string", "null"], "pattern": "^https?://", "maxLength": 2000 },
        "publisher": { "type": ["string", "null"], "maxLength": 200 },
        "category": { "enum": ["Official", "Guide", "Wiki", "Forum", "User", "Other"] },
        "reliability": { "enum": ["Official", "ReputableGuide", "Community", "UserSubmitted", "Unknown"] },
        "contentUpdatedOn": { "$ref": "#/definitions/nullableDate" },
        "retrievedOn": { "$ref": "#/definitions/nullableDate" },
        "lastCheckedOn": { "$ref": "#/definitions/nullableDate" },
        "notes": { "$ref": "#/definitions/nullableText" }
      }
    },
    "alias": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 200 },
        "locale": { "type": ["string", "null"], "maxLength": 10 }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "to"],
      "properties": {
        "type": { "enum": ["LocatedIn", "PartOf", "MemberOfFamily", "Summons", "CastsSpell"] },
        "to": { "$ref": "#/definitions/id" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "canonicalName", "verification"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "type": { "$ref": "#/definitions/entityType" },
        "canonicalName": { "type": "string", "minLength": 1, "maxLength": 200 },
        "locale": { "type": "string", "maxLength": 10 },
        "description": { "$ref": "#/definitions/nullableText" },
        "aliases": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/alias" } },
        "levelText": { "type": ["string", "null"], "maxLength": 50 },
        "attributes": {
          "type": "object",
          "maxProperties": 100,
          "additionalProperties": { "type": "string", "maxLength": 1000 }
        },
        "verification": { "$ref": "#/definitions/verification" },
        "versionScope": { "type": ["string", "null"], "maxLength": 200 },
        "sourceIds": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/id" } },
        "relations": { "type": "array", "maxItems": 500, "items": { "$ref": "#/definitions/relation" } }
      }
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description"],
      "properties": {
        "kind": { "enum": ["Manual", "EntityPresent", "EntityAbsent", "StateActive", "TurnAtLeast", "TurnAtMost", "TurnEven", "TurnOdd"] },
        "description": { "$ref": "#/definitions/text" },
        "entityId": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"], "maxLength": 200 },
        "number": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "action"],
      "properties": {
        "order": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "action": { "$ref": "#/definitions/text" },
        "target": { "$ref": "#/definitions/nullableText" },
        "position": { "$ref": "#/definitions/nullableText" },
        "requiredState": { "$ref": "#/definitions/nullableText" },
        "when": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/condition" }] },
        "rationale": { "$ref": "#/definitions/nullableText" },
        "verification": { "oneOf": [{ "type": "null" }, { "$ref": "#/definitions/verification" }] }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steps"],
      "properties": {
        "label": { "type": ["string", "null"], "maxLength": 200 },
        "steps": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/definitions/step" } }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": { "enum": ["Warning", "CommonMistake", "FailureCase", "Exception", "Restriction"] },
        "text": { "$ref": "#/definitions/text" }
      }
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "$ref": "#/definitions/id" },
        "quote": { "type": ["string", "null"], "maxLength": 600 },
        "locator": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "mechanic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entityId", "type", "title", "verification", "sources"],
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "entityId": { "$ref": "#/definitions/id" },
        "type": { "enum": ["Invulnerability", "Unlock", "SpecialRule", "Phase", "Summon", "Positioning", "SpellEffect", "Resistance", "Other"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "$ref": "#/definitions/nullableText" },
        "verification": { "$ref": "#/definitions/verification" },
        "prerequisites": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/condition" } },
        "sequences": { "type": "array", "maxItems": 10, "items": { "$ref": "#/definitions/sequence" } },
        "expectedStateChange": { "$ref": "#/definitions/nullableText" },
        "expectedResult": { "$ref": "#/definitions/nullableText" },
        "vulnerabilityDuration": { "type": ["string", "null"], "maxLength": 200 },
        "turnConditions": { "$ref": "#/definitions/nullableText" },
        "notes": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/note" } },
        "unknownAspects": { "type": "array", "maxItems": 50, "items": { "$ref": "#/definitions/text" } },
        "versionScope": { "type": ["string", "null"], "maxLength": 200 },
        "lastVerifiedOn": { "$ref": "#/definitions/nullableDate" },
        "sources": {
          "type": "array",
          "description": "Every mechanic must cite at least one source.",
          "minItems": 1,
          "maxItems": 20,
          "items": { "$ref": "#/definitions/sourceRef" }
        }
      }
    }
  }
}
