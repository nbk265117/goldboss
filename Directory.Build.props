<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>0.3.1</Version>
    <Company>Dofus Companion contributors</Company>
    <Product>Dofus Companion</Product>
    <Copyright>Dofus Companion contributors. Not affiliated with Ankama.</Copyright>
    <!-- Noise from analyzers that does not fit a desktop app (localized UI, logging style). -->
    <NoWarn>$(NoWarn);CA1303;CA1848;CA1515;CA1031;CA2007;CA1716;CA1720;CA1711;CA1002;CA2227;CA1819;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1062;CA1724;CA1056;CA1054;CA1055;CA2234;CA1812;CA1805;CA1822;CA1860;CA1861;CA1866;CA1865;CA1847;CA5394;CA1308;CA1814;CA1508;CA1823;CA1859;CA1873</NoWarn>
  </PropertyGroup>
</Project>
