<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>DofusCompanion.App</RootNamespace>
    <AssemblyName>DofusCompanion</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- Required by source-generated LibraryImport P/Invoke marshalling (Services/NativeMethods.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1001: view models are app-lifetime singletons; their CancellationTokenSources own no timers or handles.
         CA1826: FirstOrDefault on small UI lists is clearer than index checks. -->
    <NoWarn>$(NoWarn);CA1001;CA1826;CA1834</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DofusCompanion.Infrastructure\DofusCompanion.Infrastructure.csproj" />
    <ProjectReference Include="..\DofusCompanion.Ocr.Windows\DofusCompanion.Ocr.Windows.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="System.IO" />
    <InternalsVisibleTo Include="DofusCompanion.Core.Tests" />
  </ItemGroup>
</Project>
