<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark palette. Text/background pairs keep WCAG AA contrast (>= 4.5:1). -->
    <SolidColorBrush x:Key="Bg" Color="#1B1F24"/>
    <SolidColorBrush x:Key="Panel" Color="#242A31"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#2C333B"/>
    <SolidColorBrush x:Key="Border" Color="#3A444F"/>
    <SolidColorBrush x:Key="Text" Color="#E8EAED"/>
    <SolidColorBrush x:Key="Muted" Color="#AAB3BD"/>
    <SolidColorBrush x:Key="Accent" Color="#3FB59B"/>
    <SolidColorBrush x:Key="AccentText" Color="#0E1A17"/>
    <SolidColorBrush x:Key="Good" Color="#5CCB94"/>
    <SolidColorBrush x:Key="Caution" Color="#E9B44C"/>
    <SolidColorBrush x:Key="Bad" Color="#F27B74"/>
    <SolidColorBrush x:Key="GoodBg" Color="#1E3A2D"/>
    <SolidColorBrush x:Key="CautionBg" Color="#3D3220"/>
    <SolidColorBrush x:Key="BadBg" Color="#45231F"/>
    <SolidColorBrush x:Key="Hover" Color="#333C46"/>
    <SolidColorBrush x:Key="Selection" Color="#2F5249"/>
    <SolidColorBrush x:Key="InputBg" Color="#1F2429"/>
</ResourceDictionary>
