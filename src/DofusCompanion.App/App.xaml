<Application x:Class="DofusCompanion.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Replaced at runtime by ThemeManager (Colors.Dark / Colors.Light). -->
                <ResourceDictionary Source="/DofusCompanion;component/Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="/DofusCompanion;component/Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
